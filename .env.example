# ==============================================================================
# SAMSTRUST TECHNOLOGIES LIMITED (RC 9898142) - ENTERPRISE DIGITAL PLATFORM
# Environment Configuration Blueprint (.env.example)
# Unifies Corporate Public Website (www.samstrusttech.com) & Customer/Staff Portal
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_NAME="Samstrust Technologies Limited Digital Platform"
APP_DOMAIN=https://www.samstrusttech.com
PORTAL_BASE_URL=https://www.samstrusttech.com/portal
COMPANY_RC_NUMBER="RC 9898142"
CORPORATE_SUPPORT_EMAIL="Info@samstrusttech.com"
CORPORATE_HOTLINE="+2348029844356"

# ------------------------------------------------------------------------------
# 2. MYSQL / MARIADB RELATIONAL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=samstrust_enterprise_prod
DB_USERNAME=samstrust_db_app
DB_PASSWORD=REPLACE_WITH_64_CHAR_HIGH_ENTROPY_DB_SECRET
DB_POOL_MIN=5
DB_POOL_MAX=30
DB_SSL_MODE=REQUIRED
DB_SSL_CA_PATH=/etc/ssl/certs/samstrust-rds-ca-bundle.pem
DB_TIMEZONE="+01:00"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION, JWT & CRYPTOGRAPHIC SECRETS
# ------------------------------------------------------------------------------
# Minimum 256-bit (64 hex chars) secrets for HMAC-SHA256 token signing
JWT_SECRET=REPLACE_WITH_256_BIT_HEX_SECRET
JWT_ACCESS_TOKEN_SECRET=REPLACE_WITH_256_BIT_HEX_ACCESS_SECRET
JWT_REFRESH_TOKEN_SECRET=REPLACE_WITH_256_BIT_HEX_REFRESH_SECRET
JWT_EXPIRES_IN=24h
JWT_ACCESS_EXPIRY_SECONDS=28800
JWT_REFRESH_EXPIRY_SECONDS=604800
PASSWORD_HASH_ALGO=PBKDF2_HMAC_SHA256
PASSWORD_PBKDF2_ITERATIONS=310000
PASSWORD_PEPPER_SECRET=REPLACE_WITH_SERVER_SIDE_PEPPER_SECRET
MFA_TOTP_ISSUER="Samstrust Technologies Limited"
ANTI_IDOR_STRICT_OWNERSHIP_ENFORCEMENT=true

# ------------------------------------------------------------------------------
# 4. SECURE DOCUMENT STORAGE & FILE UPLOAD VALIDATION
# ------------------------------------------------------------------------------
# Drivers: local_encrypted | s3_compatible
STORAGE_DRIVER=s3_compatible
STORAGE_LOCAL_ROOT=/var/samstrust/vault/documents
STORAGE_S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
STORAGE_S3_BUCKET=samstrust-iso17025-certificates-vault
STORAGE_S3_REGION=eu-west-1
STORAGE_S3_ACCESS_KEY=REPLACE_WITH_IAM_ACCESS_KEY
STORAGE_S3_SECRET_KEY=REPLACE_WITH_IAM_SECRET_KEY

# Strict File Upload Whitelist & Size Caps (10 MB = 10485760 bytes)
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
UPLOAD_ALLOWED_EXTENSIONS=".pdf,.jpg,.jpeg,.png,.docx"
UPLOAD_VERIFY_MAGIC_BYTES=true
UPLOAD_QUARANTINE_CLAMAV_SCAN=true

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (SMTP) & WHATSAPP BUSINESS CLOUD GATEWAY
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.samstrusttech.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USERNAME=notifications@samstrusttech.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM_NAME="Samstrust Metrology & Commercial Desk"
SMTP_FROM_ADDRESS=Info@samstrusttech.com

# Meta WhatsApp Business Cloud API for Instant Calibration & Dispatch Alerts
WHATSAPP_API_VERSION=v19.0
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_META_WABA_ID
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 6. COMMERCIAL ENGINE & CURRENCY / TAX DEFAULTS
# ------------------------------------------------------------------------------
COMMERCIAL_DEFAULT_VAT_PERCENT=7.5
COMMERCIAL_DEFAULT_USD_NGN_RATE=1580.00
COMMERCIAL_QUOTE_VALIDITY_DAYS=30
ISO_17025_LAB_ACCREDITATION_CODE="STL-CAL-NG-17025"
